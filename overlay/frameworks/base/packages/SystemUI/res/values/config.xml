<resources>

    <!-- Счётчик уведомлений -->
    <integer name="status_bar_notification_info_maxnum">999</integer>

    <!-- === НАСТРОЙКИ ЗАРЯДКИ === -->
    <!-- Делитель для отображения тока (mA → A) -->
    <integer name="config_currentInfoDivider" translatable="false">1000</integer>
    <!-- Обновлять информацию каждую секунду при быстрой зарядке -->
    <bool name="config_alternateFastchargeInfoUpdate">true</bool>

    <!-- === НАСТРОЙКИ ИНТЕРФЕЙСА === -->
    <!-- On-The-Go таймауты -->
    <integer name="quick_settings_onthego_dialog_short_timeout">3000</integer>
    <integer name="quick_settings_onthego_dialog_long_timeout">6000</integer>

    <!-- Переключателя нет, оставляем по умолчанию -->
    <integer name="config_alertSliderLocation">0</integer>
    <string name="config_alertSliderIntent"></string>

    <!-- === ДАТЧИКИ === -->
    <!-- Температура CPU: cpuss-1-usr -->
    <!-- Формат: миллиградусы (делитель 1000) -->
    <string name="config_cpuTempSensor" translatable="false">/sys/class/thermal/thermal_zone45/temp</string>
    <integer name="config_cpuTempDivider" translatable="false">1000</integer>

    <!-- Счётчик FPS: найден стандартный путь -->
    <string name="config_fpsInfoSysNode" translatable="false">/sys/class/drm/sde-crtc-0/measured_fps</string>

    <!-- Какие CPU отображать в информации (оставляем пустым = все) -->
    <string name="config_displayCpus" translatable="false"></string>

    <!-- === СЕТЬ === -->
    <!-- Поддержка 5G/VoNR (Snapdragon 778G поддерживает) -->
    <bool name="config_supportsVONR">true</bool>

</resources>
